# Generated by Cargo
debug
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# Node / Next.js
node_modules/
.next/
out/
dist/
*.tsbuildinfo
.env*.local

# Local CI/debug scratch. Ten of these accumulated in the repo root during CI
# investigations (`gh run view --log` dumps, `gh pr checks` captures, `gh api`
# snapshots, and one-off reproduction scripts) because there was no ignored
# place to put them. Prefer .scratch/ for anything new.
.scratch/
*.log
/fix-*.sh
/*-log*.txt
/*-out.txt
/lint-work-*.txt
/pr-checks-*.txt
/branch-protection.json

# Cargo registry/package cache written by the Docker-based build helpers.
.cargo-docker/
